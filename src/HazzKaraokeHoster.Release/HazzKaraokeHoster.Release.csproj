<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>false</IsPackable>
    <HazzReleaseDirectory>$(MSBuildProjectDirectory)\..\..\RELEASE\HazzKaraokeHoster\</HazzReleaseDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HazzKaraokeHoster.App\HazzKaraokeHoster.App.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CreateSingleFileRelease"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(HazzReleaseDirectory)" />
    <MakeDir Directories="$(HazzReleaseDirectory)" />
    <MSBuild Projects="..\HazzKaraokeHoster.App\HazzKaraokeHoster.App.csproj"
             Targets="Publish"
             BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishReadyToRun=false;DebugType=None;DebugSymbols=false;NoBuild=false;NoRestore=true;PublishDir=$(HazzReleaseDirectory)" />
    <ItemGroup>
      <_HazzPublishedSymbols Include="$(HazzReleaseDirectory)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_HazzPublishedSymbols)" />
    <Error Condition="!Exists('$(HazzReleaseDirectory)Hazz Karaoke Hoster.exe')"
           Text="The Hazz portable release EXE was not created." />
    <Message Importance="high"
             Text="HAZZ PORTABLE FOLDER READY: $(HazzReleaseDirectory)Hazz Karaoke Hoster.exe" />
  </Target>
  <Target Name="CreateOptionalSingleExe" AfterTargets="CreateSingleFileRelease"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true' and '$(HazzBuildSingleExe)' != 'false'">
    <PropertyGroup><HazzSingleDirectory>$(MSBuildProjectDirectory)\..\..\RELEASE\SingleFile\</HazzSingleDirectory></PropertyGroup>
    <MakeDir Directories="$(HazzSingleDirectory)" />
    <MSBuild Projects="..\HazzKaraokeHoster.App\HazzKaraokeHoster.App.csproj" Targets="Publish" BuildInParallel="false"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeAllContentForSelfExtract=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishReadyToRun=false;DebugType=None;DebugSymbols=false;NoBuild=false;NoRestore=true;PublishDir=$(HazzSingleDirectory)" />
    <Error Condition="!Exists('$(HazzSingleDirectory)Hazz Karaoke Hoster.exe')" Text="The optional single EXE was not created." />
    <Message Importance="high" Text="OPTIONAL SINGLE EXE READY: $(HazzSingleDirectory)Hazz Karaoke Hoster.exe" />
  </Target>
</Project>
