<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0-android</TargetFrameworks>
    <RootNamespace>HazzKaraokeHoster.Data</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HazzKaraokeHoster.Core\HazzKaraokeHoster.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Access/OLE DB imports are Windows-only. The Android host shares the SQLite
       library/singer/playlist repositories but deliberately excludes these adapters. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'Windows'">
    <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'Android'">
    <Compile Remove="ExternalLibraryImportService.cs" />
    <Compile Remove="ExternalSingerHistoryImportService.cs" />
    <Compile Remove="KarmaImportService.cs" />
  </ItemGroup>
</Project>
