                   ToolTip="Select or drag music or music-video tracks. Double-click adds them to the Side List.">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.05*"/>
           <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.35*"/>
           <DataGridTextColumn Header="Time" Binding="{Binding DurationText}" Width="52"/>
          </DataGrid.Columns>
         </DataGrid>
        </Grid>
       </Grid>
       <Grid Grid.Row="2" Margin="6,1,6,6">
