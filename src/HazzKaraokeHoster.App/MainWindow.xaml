  <DataTemplate x:Key="MusicPlaylistItemTemplate">
   <Grid MinHeight="29">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="68"/>
     <ColumnDefinition Width="0.95*"/>
     <ColumnDefinition Width="1.25*"/>
     <ColumnDefinition Width="58"/>
    </Grid.ColumnDefinitions>
    <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
    <DockPanel Grid.Column="1" Margin="4,0">
     <Border Background="{DynamicResource SkinSurface_18212B}" CornerRadius="3" Padding="2,0" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Favourite">
      <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFavourite}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="★" Foreground="{DynamicResource SkinInk_FFFFD700}"/>
     </Border>
     <TextBlock Text="{Binding DisplayArtist}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0"/>
    <TextBlock Grid.Column="3" Text="{Binding DurationText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,6,0"/>
   </Grid>
  </DataTemplate>
