   <Setter Property="FontSize" Value="{DynamicResource HostFont13}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True">
     <Setter Property="Background" Value="{DynamicResource SkinSurface_315B76}"/>
     <Setter Property="Foreground" Value="{DynamicResource SkinInk_White}"/>
    </Trigger>
    <Trigger Property="IsSubmenuOpen" Value="True">
     <Setter Property="Background" Value="{DynamicResource SkinSurface_294A60}"/>
     <Setter Property="Foreground" Value="{DynamicResource SkinInk_White}"/>
    </Trigger>
    <Trigger Property="IsEnabled" Value="False">
