       </Grid>
       <Grid Grid.Row="3" Margin="0,5,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SkinSurface_0F161E}" BorderBrush="{DynamicResource SkinEdge_354655}" BorderThickness="1" CornerRadius="4" Padding="5" Margin="3">
         <StackPanel>
          <TextBlock Text="KEY" HorizontalAlignment="Center" FontSize="{DynamicResource HostFont12}" FontWeight="Bold" Foreground="{DynamicResource SkinInk_9FB0C1}"/>
          <WrapPanel HorizontalAlignment="Center">
           <Button Content="−" Style="{StaticResource LoadButtonStyle}" Click="KeyDown_Click" MinWidth="38"/>
           <TextBlock x:Name="KeyText" Text="0" FontSize="{DynamicResource HostFont23}" Width="46" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
           <Button Content="+" Style="{StaticResource LoadButtonStyle}" Click="KeyUp_Click" MinWidth="38"/>
           <Button Content="RESET" Style="{StaticResource PauseButtonStyle}" Click="KeyReset_Click"/>
          </WrapPanel>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource SkinSurface_0F161E}" BorderBrush="{DynamicResource SkinEdge_354655}" BorderThickness="1" CornerRadius="4" Padding="5" Margin="3">
         <StackPanel>
          <TextBlock Text="CDG / VIDEO AV SYNC · + ADVANCES · − DELAYS" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="{DynamicResource HostFont12}" FontWeight="Bold" Foreground="{DynamicResource SkinInk_9FB0C1}"/>
          <WrapPanel HorizontalAlignment="Center">
           <Button Content="−0.25s" Style="{StaticResource LoadButtonStyle}" Click="CdgEarlier_Click"/>
           <TextBlock x:Name="CdgSyncText" Text="0.00s" FontSize="{DynamicResource HostFont22}" Width="78" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
           <Button Content="+0.25s" Style="{StaticResource LoadButtonStyle}" Click="CdgLater_Click"/>
           <Button Content="RESET" Style="{StaticResource PauseButtonStyle}" Click="CdgReset_Click"/><Button Content="SAVE" Style="{StaticResource LoadButtonStyle}" Click="SaveAvSync_Click" ToolTip="Save this CDG/video sync correction for this song. Reset then Save restores zero."/>
          </WrapPanel>
         </StackPanel>
        </Border>
       </Grid>
       <Border x:Name="MusicAutomationPanel" Grid.Row="4" Background="{DynamicResource SkinSurface_0F161E}" BorderBrush="{DynamicResource SkinEdge_354655}" BorderThickness="1" CornerRadius="4" Padding="5" Margin="3,5,3,2">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <WrapPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
          <CheckBox x:Name="AutoCrossfadeCheck" Content="AUTO CROSSFADE" IsChecked="True" VerticalAlignment="Center"/>
          <TextBlock Text="TIME" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource SkinInk_9FB0C1}" FontWeight="SemiBold"/>
          <Slider x:Name="CrossfadeSecondsSlider" Minimum="0.5" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="4" Width="145" ValueChanged="CrossfadeSeconds_ValueChanged" VerticalAlignment="Center" Margin="3,0"/>
          <TextBlock x:Name="CrossfadeSecondsText" Text="4.0s" Width="48" VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>
          <Button x:Name="FadeNowButton" Content="FADE NOW" Style="{StaticResource SpecialButtonStyle}" Click="FadeNow_Click" MinWidth="92" ToolTip="Immediately start the configured crossfade from the playing music deck to the other deck."/>
          <Button x:Name="PlayMusicButton" Content="▶ PLAY MUSIC" Style="{StaticResource PlayButtonStyle}" Click="PlayMusic_Click" MinWidth="110" ToolTip="Stop karaoke if necessary and start the next music track that was scheduled before karaoke."/>
         </WrapPanel>
         <TextBlock x:Name="NextCueStatus" Grid.Row="1" VerticalAlignment="Bottom" Margin="4,20,4,0" Text="Next track: idle" Foreground="{DynamicResource SkinInk_FFD34D}" TextWrapping="Wrap"/><TextBlock x:Name="MusicAutomationStatus" Grid.Row="1" Text="Music ready" HorizontalAlignment="Center" Margin="4,2" Foreground="{DynamicResource SkinInk_9EABB9}" TextTrimming="CharacterEllipsis"/>
         <Grid Grid.Row="2" Margin="2,3,2,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="DECK 1" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Slider x:Name="VisualCrossfaderSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="0" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Center" ToolTip="Live visual crossfade position. Left = Deck 1, right = Deck 2."/>
          <TextBlock x:Name="CrossfaderPositionText" Grid.Column="2" Text="D1 100%  •  D2 0%" Width="120" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SkinInk_C9D5E0}" FontWeight="SemiBold" Margin="8,0"/>
          <TextBlock Grid.Column="3" Text="DECK 2" FontWeight="Bold" VerticalAlignment="Center" />
         </Grid>
        </Grid>
       </Border>
       <Border Grid.Row="5" Background="{DynamicResource SkinSurface_0F161E}" BorderBrush="{DynamicResource SkinEdge_354655}" BorderThickness="1" CornerRadius="4" Padding="5" Margin="3,3,3,2">
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
         <CheckBox x:Name="AutoSkipSilenceCheck" Content="SKIP SILENT INTRO" IsChecked="True" ToolTip="At the start of karaoke, jump over leading silence only. Mid-song quiet sections are never skipped automatically."/>
         <Button Content="SKIP SILENCE NOW" Style="{StaticResource PauseButtonStyle}" Click="SkipSilenceNow_Click" ToolTip="If the karaoke is currently in a silent section, jump to the next audible section."/>
         <TextBlock Text="PRE-ROLL" Foreground="{DynamicResource SkinInk_9FB0C1}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,4,0"/>
         <Slider x:Name="SkipSilencePreRollSlider" Minimum="0" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="0.5" Width="130" Margin="3,0"
                 ValueChanged="SkipSilencePreRoll_ValueChanged" VerticalAlignment="Center"/>
         <TextBlock x:Name="SkipSilencePreRollText" Text="0.50s" Width="48" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center"/>
        </WrapPanel>
       </Border>
       <TextBlock Grid.Row="6" Text="Dedicated karaoke playback · MP3+G / ZIP / Video" Foreground="{DynamicResource SkinInk_718294}" FontSize="{DynamicResource HostFont11}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,3,0,0"/>
       </Grid>
      </ScrollViewer>
     </Grid>
    </Border>

    <Grid x:Name="SingerListHome" Grid.Row="2">
    <Border x:Name="SingerListPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SkinEdge_40505F}" BorderThickness="1" CornerRadius="5">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="38"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SkinSurface_263747}" CornerRadius="5,5,0,0">
       <Grid>
        <TextBlock x:Name="QueueTimeText" Text="REMAINING 0m" FontSize="{DynamicResource HostFont11}" FontWeight="SemiBold" Foreground="{DynamicResource SkinInk_AFC3D5}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" ToolTip="Estimated time to finish the current karaoke song plus all queued requests. Unknown track lengths use a 4-minute estimate."/>
        <TextBlock Text="KARAOKE SINGERS LIST" FontSize="{DynamicResource HostFont17}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Button x:Name="PreviewToggleButton" Content="HIDE PREVIEW" Style="{StaticResource CompactHeaderButtonStyle}" Background="#67428B" BorderBrush="#B58AE0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="TogglePreview_Click" ToolTip="Show or hide the complete audience display preview."/>
       </Grid>
      </Border>
     <Grid Grid.Row="1" Margin="7,5,7,3">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Grid.Row="0" Grid.Column="0" Text="SINGER NAME" Foreground="{DynamicResource SkinInk_AFC3D5}" FontSize="{DynamicResource HostFont10}" FontWeight="Bold" Margin="2,0,5,2"/>
       <ComboBox x:Name="SingerNameBox" Grid.Row="1" Grid.Column="0" ToolTip="Enter a new singer or type to search all saved singers. Shows up to 100, most recently used first." FontSize="{DynamicResource HostFont15}" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                 PreviewKeyDown="SingerEntry_PreviewKeyDown" MaxDropDownHeight="320" DropDownOpened="SingerPicker_Opened" DropDownClosed="SingerPicker_Closed" TextBoxBase.TextChanged="SingerPicker_TextChanged"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True">
        <ComboBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ComboBox.ItemsPanel>
       </ComboBox>
       <Button x:Name="GlobalTempoButton" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Content="TEMPO" Style="{StaticResource SpecialButtonStyle}" Click="Tempo_Click" ToolTip="Adjust the playing song: karaoke, music or music video. Save for this track, or reset to normal."/>
       <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Content="ADD SINGER" Style="{StaticResource LoadButtonStyle}" Click="AddSinger_Click"/>
      </Grid>
      <DataGrid x:Name="QueueList" Grid.Row="2" Margin="7,3" AutoGenerateColumns="False" IsReadOnly="True" FontSize="{DynamicResource HostFont14}"
                AllowDrop="True"
                PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                PreviewMouseMove="QueueList_PreviewMouseMove"
                MouseDoubleClick="QueueList_MouseDoubleClick"
                PreviewMouseRightButtonDown="QueueList_PreviewMouseRightButtonDown"
                DragOver="QueueList_DragOver"
                Drop="QueueList_Drop"
                ToolTip="Rotation shows every non-HOLD singer standing (1 / total), even before they choose a song. NEXT highlights the first singer who has a song ready. Drag singers to reorder, or drag a KARAOKE result onto a singer.">
       <DataGrid.RowStyle>
        <Style TargetType="{x:Type DataGridRow}">
         <Setter Property="BorderThickness" Value="0"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsNextSinger}" Value="True">
           <Setter Property="Background" Value="#3DFFD34D"/>
           <Setter Property="BorderBrush" Value="#FFFFD34D"/>
           <Setter Property="BorderThickness" Value="2"/>
           <Setter Property="FontWeight" Value="Bold"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsHeld}" Value="True">
           <Setter Property="Opacity" Value="0.62"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </DataGrid.RowStyle>
       <DataGrid.ContextMenu>
        <ContextMenu Opened="SingerContextMenu_Opened">
         <MenuItem Header="ADD SONG / SEARCH…" Click="SingerMenuAddSong_Click"/>
         <MenuItem Header="OPEN SONGS &amp; HISTORY…" Click="SingerMenuOpenHistory_Click"/>
         <Separator/>
         <MenuItem Header="HOLD SINGER" Tag="HoldToggle" Click="SingerMenuHold_Click"/>
         <MenuItem Header="SKIP ONCE (MOVE TO BOTTOM)" Click="SingerMenuSkipOnce_Click"/>
         <MenuItem Header="SET AS NEXT" Click="SingerMenuSetNext_Click"/>
         <MenuItem Header="MOVE UP" Click="SingerMenuMoveUp_Click"/>
         <MenuItem Header="MOVE DOWN" Click="SingerMenuMoveDown_Click"/>
         <MenuItem Header="MOVE TO TOP" Click="SingerMenuMoveTop_Click"/>
         <Separator/>
         <MenuItem Header="KAMIKAZE FOR THIS SINGER" Click="SingerMenuKamikaze_Click"/>
         <MenuItem Header="CLEAR QUEUED SONGS" Click="SingerMenuClearSongs_Click"/>
         <MenuItem Header="EDIT NAME / NOTES…" Click="SingerMenuEdit_Click"/>
         <MenuItem Header="CHOOSE SINGER PHOTO…" Click="SingerPhotoChoose_Click"/>
         <MenuItem Header="TAKE SINGER PHOTO WITH WEBCAM…" Click="SingerPhotoWebcam_Click"/>
         <MenuItem Header="REMOVE SINGER PHOTO" Click="SingerPhotoRemove_Click"/>
         <Separator/>
         <MenuItem Header="REMOVE FROM SHOW" Click="SingerMenuRemove_Click"/>
       </ContextMenu>
       </DataGrid.ContextMenu>
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Rotation" Width="Auto" MinWidth="82">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <Border Padding="6,2" Margin="1" CornerRadius="4">
            <Border.Style>
             <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding IsNextSinger}" Value="True">
                <Setter Property="Background" Value="#FFFFD34D"/>
                <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Border.Style>
            <TextBlock Text="{Binding RotationBadgeText}" HorizontalAlignment="Center" FontWeight="SemiBold">
             <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
               <Setter Property="Foreground" Value="{DynamicResource SkinInk_D8E2EC}"/>
               <Style.Triggers>
                <DataTrigger Binding="{Binding IsNextSinger}" Value="True">
                 <Setter Property="Foreground" Value="Black"/>
                 <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
               </Style.Triggers>
              </Style>
             </TextBlock.Style>
            </TextBlock>
           </Border>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Photo" Width="Auto">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <local:SingerPortrait Width="28" Height="28" Margin="2"
                                  SingerName="{Binding SingerName}"
                                  VenueKey="{Binding DataContext.SingerPhotoVenue, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Revision="{Binding DataContext.SingerPhotoRevision, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto"/>
        <DataGridTextColumn Header="Singer" Binding="{Binding SingerName}" Width="1.05*" MinWidth="100"/>
        <DataGridTextColumn Header="Next Song" Binding="{Binding NextSongTitle}" Width="1.45*" MinWidth="140"/>
        <DataGridTextColumn Header="Artist" Binding="{Binding NextArtist}" Width="1.05*" MinWidth="100"/>
        <DataGridTextColumn Header="Songs" Binding="{Binding SongCount}" Width="Auto"/>
        <DataGridTextColumn Header="Key" Binding="{Binding NextKey}" Width="Auto"/>
        <DataGridTextColumn Header="Sync" Binding="{Binding NextSync, StringFormat={}{0:+0.00;-0.00;0.00}s}" Width="Auto"/>
       </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="3" Margin="4,2,4,6">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="QueueDragHint" Grid.Column="0" Text="Drag to reorder • right-click singer for Hold / Skip / History / Kamikaze / Remove" Foreground="{DynamicResource SkinInk_7F91A3}" VerticalAlignment="Center" Margin="5,0"/>
       <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button Content="▲ MOVE UP" Style="{StaticResource LoadButtonStyle}" Click="QueueUp_Click"/>
        <Button Content="▼ MOVE DOWN" Style="{StaticResource LoadButtonStyle}" Click="QueueDown_Click"/>
        <Button Content="SET AS NEXT" Style="{StaticResource PlayButtonStyle}" Click="SetNext_Click"/>
        <Button Content="REMOVE" Style="{StaticResource StopButtonStyle}" Click="QueueRemove_Click"/>
       </WrapPanel>
      </Grid>
     </Grid>
    </Border>
    </Grid>

