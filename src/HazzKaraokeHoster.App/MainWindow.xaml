   <Setter Property="Foreground" Value="{DynamicResource SkinInk_F4F7FA}"/>
   <Setter Property="Background" Value="{DynamicResource SkinSurface_18222D}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SkinEdge_344454}"/>
