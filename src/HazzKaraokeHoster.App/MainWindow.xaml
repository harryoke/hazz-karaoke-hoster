         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock x:Name="SideFolderLocationText" Text="ALL MUSIC" FontWeight="Bold" Foreground="{DynamicResource SkinInk_D8E2EC}" Margin="4,1,4,4" TextTrimming="CharacterEllipsis"/>
         <DataGrid x:Name="SideVirtualFolderTracks" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
