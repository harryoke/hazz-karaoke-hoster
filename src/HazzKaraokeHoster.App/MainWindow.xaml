  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource SkinInk_White}"/>
   <Setter Property="Background" Value="{DynamicResource SkinSurface_0D131A}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SkinEdge_44515F}"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="CaretBrush" Value="White"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource SkinInk_White}"/>
   <Setter Property="Background" Value="{DynamicResource SkinSurface_202A35}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SkinEdge_657585}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="5,3"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="MinHeight" Value="29"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="ComboChrome" Background="{DynamicResource SkinSurface_18232D}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
       <ContentPresenter x:Name="SelectionPresenter" Margin="8,2,29,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                         Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                         ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>
       <TextBox x:Name="PART_EditableTextBox" Margin="5,2,29,2" Padding="2,0" VerticalContentAlignment="Center"
                Background="{DynamicResource SkinSurface_18232D}" Foreground="{DynamicResource SkinInk_White}" BorderThickness="0" CaretBrush="White" Visibility="Hidden"/>
       <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Right" Width="27" Margin="0" Padding="0" Focusable="False"
                     ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ArrowChrome" Background="{DynamicResource SkinSurface_2D3B47}" BorderBrush="{DynamicResource SkinEdge_657585}" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0">
           <Path Width="8" Height="5" Fill="{DynamicResource SkinInk_F7FAFC}" Stretch="Fill" Data="M 0 0 L 8 0 L 4 5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource SkinSurface_356B8F}"/></Trigger>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource SkinSurface_285577}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360"
                Background="{DynamicResource SkinSurface_111A22}" BorderBrush="{DynamicResource SkinEdge_8294A4}" BorderThickness="1" Padding="2">
         <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" CanContentScroll="True">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsEditable" Value="True">
        <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Hidden"/>
        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#7EDCFF"/></Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="ComboChrome" Property="Background" Value="#25303A"/>
        <Setter Property="Foreground" Value="{DynamicResource SkinInk_C5D0DA}"/>
        <Setter TargetName="PART_EditableTextBox" Property="Foreground" Value="#C5D0DA"/>
        <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.6"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource SkinInk_F7FAFC}"/>
   <Setter Property="Background" Value="{DynamicResource SkinSurface_18222D}"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="FontSize" Value="{DynamicResource HostFont13_5}"/>
