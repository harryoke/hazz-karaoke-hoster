       <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SkinSurface_285577}"/><Setter Property="Foreground" Value="{DynamicResource SkinInk_White}"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SkinInk_93A3B2}"/></Trigger>
      </ControlTemplate.Triggers>
