         <Button Content="NEXT ▶" Style="{StaticResource LoadButtonStyle}" Click="SideFolderNext_Click" ToolTip="Next page."/>
         <Button Content="ADD TO SIDE LIST" Style="{StaticResource SaveButtonStyle}" Click="SideFolderAddToSideList_Click" ToolTip="Copy selected tracks into the holding side list."/>
         <Button Content="SEND TO DECK 1 →" Style="{StaticResource PlayButtonStyle}" Click="SideFolderSendToDeck1_Click" ToolTip="Copy selected tracks straight into Deck 1."/>
        </WrapPanel>
       </Grid>
      </Grid>
     </Grid>
