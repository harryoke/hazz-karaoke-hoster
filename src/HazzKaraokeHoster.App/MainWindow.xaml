       <CheckBox x:Name="TransparentCdgCheck" Content="Transparent CD+G background" Checked="CdgPresentationChanged" Unchecked="CdgPresentationChanged"/>
       <TextBlock Text="Remove colour" VerticalAlignment="Center" Margin="4"/>
       <ComboBox x:Name="CdgColourCombo" MinWidth="130" SelectionChanged="CdgPresentationChanged" ToolTip="Auto follows the CD+G background colour. Choose a numbered palette colour if Auto removes the wrong areas."><ComboBoxItem Content="Auto" IsSelected="True"/><ComboBoxItem Content="Palette 0"/><ComboBoxItem Content="Palette 1"/><ComboBoxItem Content="Palette 2"/><ComboBoxItem Content="Palette 3"/><ComboBoxItem Content="Palette 4"/><ComboBoxItem Content="Palette 5"/><ComboBoxItem Content="Palette 6"/><ComboBoxItem Content="Palette 7"/><ComboBoxItem Content="Palette 8"/><ComboBoxItem Content="Palette 9"/><ComboBoxItem Content="Palette 10"/><ComboBoxItem Content="Palette 11"/><ComboBoxItem Content="Palette 12"/><ComboBoxItem Content="Palette 13"/><ComboBoxItem Content="Palette 14"/><ComboBoxItem Content="Palette 15"/></ComboBox>
       <Button Content="RESTORE ORIGINAL" Click="RestoreCdgOriginal_Click"/>
      </WrapPanel>
      <WrapPanel>
       <TextBlock Text="Background opacity" VerticalAlignment="Center" Margin="4"/><Slider x:Name="CdgBackgroundOpacitySlider" Minimum="0" Maximum="1" Value="0.6" Width="130" ValueChanged="CdgPresentationChanged"/><TextBlock Text="{Binding ElementName=CdgBackgroundOpacitySlider, Path=Value, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
       <TextBlock Text="Lyrics opacity" VerticalAlignment="Center" Margin="12,0,4,0"/><Slider x:Name="CdgLyricsOpacitySlider" Minimum="0" Maximum="1" Value="1" Width="130" ValueChanged="CdgPresentationChanged"/><TextBlock Text="{Binding ElementName=CdgLyricsOpacitySlider, Path=Value, StringFormat={}{0:P0}}" VerticalAlignment="Center"/>
       <Button Content="SAVE FOR THIS SONG" Click="SaveCdgPresentation_Click"/>
       <Button Content="USE DEFAULTS" Click="ClearCdgPresentation_Click"/>
      </WrapPanel>
      <TextBlock Text="CD+G only. Artwork using the removed colour may also disappear. Enable Singer-view background below to use your image, GIF, video or slideshow." TextWrapping="Wrap" Margin="4"/>
      <TextBlock Text="Second scroller uses the opposite edge. Insets are limited automatically to prevent overlap." TextWrapping="Wrap" Margin="4"/>
      </StackPanel>

      <Border Grid.Row="6" BorderBrush="{DynamicResource SkinEdge_3C4A58}" BorderThickness="1,1,1,0" Margin="0,2,0,8"/>

      <Grid Grid.Row="7" Margin="0,2,0,7">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="AudienceBackgroundEnabledCheck" Grid.Column="0" Content="Singer-view background" Checked="OverlayChanged" Unchecked="OverlayChanged" ToolTip="Shown between karaoke songs behind the Next Singer display."/>
       <StackPanel Grid.Column="1"><Button Content="IMAGE / GIF / VIDEO…" Style="{StaticResource LoadButtonStyle}" Click="ChooseAudienceBackground_Click"/><Button Content="CHOOSE FOLDER…" Style="{StaticResource LoadButtonStyle}" Click="ChooseAudienceBackgroundFolder_Click" ToolTip="Slideshow: images and muted looping videos, one minute each"/></StackPanel>
       <Button Grid.Column="2" Content="CLEAR" Style="{StaticResource StopButtonStyle}" Click="ClearAudienceBackground_Click"/>
       <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0">
        <TextBlock x:Name="AudienceBackgroundFileText" Text="No background selected" Foreground="{DynamicResource SkinInk_D8E2EC}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
        <WrapPanel Margin="8,4,0,0">
         <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
         <TextBlock Text="Screen fit" VerticalAlignment="Center"/>
         <ComboBox x:Name="BackgroundStretchCombo" MinWidth="145" Margin="8,0,18,0" SelectionChanged="OverlayChanged" ToolTip="Fit shows the whole image; Fill crops edges; Stretch fills without cropping; Center keeps the original size"><ComboBoxItem Content="Fit" IsSelected="True"/><ComboBoxItem Content="Fill (crop)"/><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Center"/></ComboBox>
         </StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
         <TextBlock Text="GIF speed" VerticalAlignment="Center"/>
         <Slider x:Name="BackgroundGifSpeedSlider" Minimum="0.25" Maximum="4" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" Width="150" Margin="8,0" ValueChanged="OverlayChanged" ToolTip="GIF playback speed: 0.25x to 4x. Slideshow slots stay one minute."/>
         <TextBlock Text="{Binding ElementName=BackgroundGifSpeedSlider, Path=Value, StringFormat={}{0:0.##}x}" VerticalAlignment="Center"/>
        </StackPanel>
        </WrapPanel>
       </StackPanel>
      </Grid>

      <Grid Grid.Row="8" Margin="0,2,0,4">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="AudienceLogoEnabledCheck" Grid.Column="0" Content="Persistent audience logo" Checked="OverlayChanged" Unchecked="OverlayChanged" ToolTip="When enabled, the logo stays above CD+G and video karaoke."/>
       <Button Grid.Column="1" Content="CHOOSE LOGO…" Style="{StaticResource LoadButtonStyle}" Click="ChooseAudienceLogo_Click"/>
       <Button Grid.Column="2" Content="CLEAR" Style="{StaticResource StopButtonStyle}" Click="ClearAudienceLogo_Click"/>
       <TextBlock x:Name="AudienceLogoFileText" Grid.Column="3" Text="No logo selected" Foreground="{DynamicResource SkinInk_D8E2EC}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
      </Grid>

      <WrapPanel Grid.Row="9" Margin="26,0,0,2">
       <TextBlock Text="Logo position" VerticalAlignment="Center" Margin="4"/>
       <ComboBox x:Name="LogoPositionCombo" MinWidth="150" SelectionChanged="OverlayChanged">
        <ComboBoxItem Content="TopLeft"/><ComboBoxItem Content="TopCenter"/><ComboBoxItem Content="TopRight" IsSelected="True"/>
        <ComboBoxItem Content="BottomLeft"/><ComboBoxItem Content="BottomCenter"/><ComboBoxItem Content="BottomRight"/>
       </ComboBox>
       <TextBlock Text="Logo width" VerticalAlignment="Center" Margin="10,4,4,4"/>
       <Slider x:Name="LogoWidthSlider" Minimum="60" Maximum="800" Value="180" Width="190" TickFrequency="20" ValueChanged="LogoWidthSlider_ValueChanged" VerticalAlignment="Center"/>
       <TextBlock x:Name="LogoWidthText" Text="180px" Width="60" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center"/>
       <TextBlock Text="Transparent PNG recommended. Logo always stays above CD+G/video." Foreground="{DynamicResource SkinInk_D0DAE4}" VerticalAlignment="Center" Margin="10,0,0,0"/>
      </WrapPanel>

      <Border Grid.Row="10" BorderBrush="{DynamicResource SkinEdge_596B7A}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,10,0,0" Background="{DynamicResource SkinSurface_151F29}">
       <StackPanel>
        <TextBlock Text="MUSIC VIDEO DISPLAY" FontWeight="Bold" Margin="3,0,3,6"/>
        <WrapPanel Margin="0,0,0,6">
         <TextBlock Text="Video fit" VerticalAlignment="Center" Margin="4"/>
         <ComboBox x:Name="MusicVideoSizingCombo" MinWidth="100" SelectionChanged="OverlayChanged" ToolTip="Fit preserves the video's proportions. Stretch fills the audience screen."><ComboBoxItem Content="Fit" IsSelected="True"/><ComboBoxItem Content="Stretch"/></ComboBox>
         <TextBlock Text="Transition" VerticalAlignment="Center" Margin="12,4,4,4"/>
         <ComboBox x:Name="MusicVideoTransitionCombo" MinWidth="180" SelectionChanged="OverlayChanged" ToolTip="Visual transition used when a new music video appears. Audio timing and crossfades remain separate.">
          <ComboBoxItem Content="Cut" IsSelected="True"/><ComboBoxItem Content="Random Fancy"/>
          <ComboBoxItem Content="Fade from Black"/><ComboBoxItem Content="Fade from White"/><ComboBoxItem Content="Flash White"/>
          <ComboBoxItem Content="Wipe Left"/><ComboBoxItem Content="Wipe Right"/><ComboBoxItem Content="Wipe Up"/><ComboBoxItem Content="Wipe Down"/>
          <ComboBoxItem Content="Zoom Reveal"/><ComboBoxItem Content="Spin Zoom"/>
          <ComboBoxItem Content="Curtain Horizontal"/><ComboBoxItem Content="Curtain Vertical"/>
          <ComboBoxItem Content="Diagonal Sweep"/><ComboBoxItem Content="Neon Sweep"/>
         </ComboBox>
         <TextBlock Text="Duration" VerticalAlignment="Center" Margin="12,4,4,4"/>
         <Slider x:Name="MusicVideoTransitionSecondsSlider" Minimum="0.1" Maximum="5" Value="0.75" TickFrequency="0.25" IsSnapToTickEnabled="True" Width="125" ValueChanged="OverlayChanged" ToolTip="Length of the visual transition only."/>
         <TextBlock Text="{Binding ElementName=MusicVideoTransitionSecondsSlider, Path=Value, StringFormat={}{0:0.00}s}" VerticalAlignment="Center" Margin="5,0,0,0" MinWidth="42"/>
        </WrapPanel>
        <TextBlock Text="SHOW DURING MUSIC VIDEOS" FontWeight="Bold" Margin="3,0,3,6"/><WrapPanel><CheckBox x:Name="MusicVideoShowLogoCheck" Content="Permanent logo" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="4,2,12,6"/><CheckBox x:Name="MusicVideoShowScrollerCheck" Content="Both scrollers" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="4,2,12,6"/><CheckBox x:Name="MusicVideoShowSingersCheck" Content="Next singers" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="4,2,12,6"/><CheckBox x:Name="MusicVideoShowKamikazeCheck" Content="Kamikaze message" Checked="OverlayChanged" Unchecked="OverlayChanged" Margin="4,2,12,6"/></WrapPanel><TextBlock Text="Unchecked items are hidden during music videos. Checked items use their normal display settings." TextWrapping="Wrap" Margin="3,0,3,10"/>        <TextBlock Text="KAMIKAZE KARAOKE AUDIENCE MESSAGE" FontWeight="Bold" Foreground="{DynamicResource SkinInk_F4F7FA}" Margin="3,0,3,6"/>
        <WrapPanel>
         <TextBlock Text="Text" VerticalAlignment="Center" Margin="4"/>
         <TextBox x:Name="KamikazeTextBox" Width="240" Text="KAMIKAZE KARAOKE!" TextChanged="OverlayChanged"/>
         <TextBlock Text="Font" VerticalAlignment="Center" Margin="8,4,4,4"/>
         <ComboBox x:Name="KamikazeFontCombo" MinWidth="180" SelectionChanged="OverlayChanged"/>
         <TextBlock Text="Size" VerticalAlignment="Center" Margin="8,4,4,4"/>
         <ComboBox x:Name="KamikazeSizeCombo" MinWidth="82" SelectionChanged="OverlayChanged">
          <ComboBoxItem Content="48"/><ComboBoxItem Content="64"/><ComboBoxItem Content="72"/><ComboBoxItem Content="84" IsSelected="True"/><ComboBoxItem Content="96"/><ComboBoxItem Content="112"/><ComboBoxItem Content="128"/>
         </ComboBox>
         <Button x:Name="KamikazeColorButton" Content="TEXT COLOUR" MinWidth="120" Background="#FFD34D" Foreground="Black" Click="KamikazeColor_Click"/>
        </WrapPanel>
        <TextBlock Text="Shown large on the audience screen after KAMIKAZE assigns a random song, and hidden the instant the next karaoke song starts." Foreground="{DynamicResource SkinInk_CAD5DF}" Margin="4,5,4,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>


     </Grid>
    </ScrollViewer>
    </DockPanel>
   </Border>
  </Popup>
 </Grid>
</Window>
