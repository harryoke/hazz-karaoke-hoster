<Window x:Class="HazzKaraokeHoster.App.VirtualFolderPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Virtual Folder" Width="480" Height="470" MinWidth="400" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#111820" Foreground="White">
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285F82"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#111820"/>
   <Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263D50"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285F82"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock x:Name="PromptText" Text="Choose the folder for the selected tracks:" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <ListBox x:Name="FolderList" Grid.Row="1" DisplayMemberPath="DisplayName" Background="#0D131A" Foreground="White"
           BorderBrush="#52687D" BorderThickness="1" MouseDoubleClick="FolderList_MouseDoubleClick"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button Content="CANCEL" Width="95" Margin="4" Padding="8" IsCancel="True"/>
   <Button Content="ADD TRACKS" Width="125" Margin="4" Padding="8" IsDefault="True"
           Background="#356F45" Foreground="White" Click="Add_Click"/>
  </StackPanel>
 </Grid>
</Window>
