<Window x:Class="HazzKaraokeHoster.App.LibrarySourcesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Library Folders" Width="760" Height="520" MinWidth="620" MinHeight="420"
 Background="#0B0F14" Foreground="White" WindowStartupLocation="CenterOwner">
 <Grid Margin="14">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock x:Name="Heading" FontSize="20" FontWeight="Bold" Text="Select library folders" Margin="0,0,0,10"/>
  <ListBox x:Name="FoldersList" Grid.Row="1" Background="#111820" Foreground="White" BorderBrush="#40505F" FontSize="14"/>
  <WrapPanel Grid.Row="2" Margin="0,10,0,8">
   <Button Content="ADD FOLDER" Click="AddFolder_Click" Padding="12,7" Margin="0,0,8,0"/>
   <Button Content="REMOVE SELECTED" Click="RemoveFolder_Click" Padding="12,7" Margin="0,0,8,0"/>
   <Button Content="CLEAR" Click="Clear_Click" Padding="12,7"/>
  </WrapPanel>
  <Grid Grid.Row="3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="HintText" Foreground="#9EABB9" VerticalAlignment="Center" TextWrapping="Wrap"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="CANCEL" IsCancel="True" Padding="14,8" Margin="4"/>
    <Button Content="IMPORT ALL" IsDefault="True" Click="Import_Click" Padding="14,8" Margin="4" Background="#3979A8"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
