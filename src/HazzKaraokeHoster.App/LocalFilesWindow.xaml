<Window x:Class="HazzKaraokeHoster.App.LocalFilesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hazz — Local drives and folders" Width="820" Height="580" MinWidth="560" MinHeight="360"
 Background="#101820" Foreground="#F3F6FA" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#263646"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#506070"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#F3F6FA"/><Setter Property="Padding" Value="3"/></Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel>
   <Button Content="DRIVES" Click="Drives_Click" ToolTip="Refresh local and removable drive roots."/>
   <Button Content="UP" Click="Up_Click"/>
   <Button Content="REFRESH" Click="Refresh_Click"/>
   <TextBlock Text="Drag files onto either music deck or the karaoke deck." VerticalAlignment="Center" Margin="8,3" TextWrapping="Wrap"/>
  </WrapPanel>
  <Grid Grid.Row="1" Margin="0,5,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
   <TextBox x:Name="AddressBox" Padding="6" KeyDown="Address_KeyDown" ToolTip="Enter a folder path and press Enter or GO."/>
   <Button Grid.Column="1" Content="GO" Click="Go_Click"/>
   <Grid Grid.Column="2" Margin="8,0,0,0">
    <TextBox x:Name="FilterBox" Padding="6" TextChanged="Filter_TextChanged" ToolTip="Filter filenames in this folder. This also searches beyond the first 5,000 displayed matches."/>
    <TextBlock Text="Filter filenames…" Foreground="#657585" Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
   </Grid>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="240" MinWidth="120"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="200"/></Grid.ColumnDefinitions>
   <TreeView x:Name="FolderTree" Background="#18232D" BorderBrush="#425364" SelectedItemChanged="Folder_Selected" TreeViewItem.Expanded="Folder_Expanded"/>
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#425364"/>
   <DataGrid x:Name="FilesGrid" Grid.Column="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
     CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" Background="#F5F7FA" Foreground="#101820"
     PreviewMouseLeftButtonDown="Files_MouseDown" PreviewMouseMove="Files_MouseMove">
    <DataGrid.Columns><DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/></DataGrid.Columns>
   </DataGrid>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="3" Text="Choose a drive or enter a folder path. Ctrl/Shift selects multiple files." TextWrapping="Wrap" Margin="3,8,3,2"/>
 </Grid>
</Window>
