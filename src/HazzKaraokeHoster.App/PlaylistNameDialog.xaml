<Window x:Class="HazzKaraokeHoster.App.PlaylistNameDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Save Music Playlist" Width="470" Height="190" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#0B0F14" Foreground="White" ShowInTaskbar="False">
 <Grid Margin="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="PLAYLIST NAME" FontSize="15" FontWeight="Bold" Foreground="#D8E3EC"/>
  <TextBox x:Name="PlaylistNameBox" Grid.Row="1" Margin="0,8,0,8" Height="34" Padding="8,5"
           FontSize="14" Background="#111820" Foreground="White" BorderBrush="#586777"
           KeyDown="PlaylistNameBox_KeyDown"/>
  <TextBlock Grid.Row="2" Text="Saving a name that already exists will update that Hazz saved playlist."
             Foreground="#93A2B2" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="CANCEL" Width="90" Height="32" Margin="4" Click="Cancel_Click"/>
   <Button Content="SAVE" Width="110" Height="32" Margin="4" Click="Save_Click" IsDefault="True"/>
  </StackPanel>
 </Grid>
</Window>
