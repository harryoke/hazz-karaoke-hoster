<Window x:Class="HazzKaraokeHoster.App.SingerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Singer Details" Width="470" Height="330" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#151A21" Foreground="White" ShowInTaskbar="False">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Text="SINGER NAME" FontWeight="Bold" Margin="0,0,0,6"/>
  <TextBox x:Name="NameBox" Grid.Row="1" FontSize="16" Padding="7"/>
  <TextBlock Grid.Row="2" Text="NOTES" FontWeight="Bold" Margin="0,16,0,6"/>
  <TextBox x:Name="NotesBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="7"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="CANCEL" Width="90" Margin="4" IsCancel="True"/>
   <Button Content="SAVE" Width="100" Margin="4" IsDefault="True" Click="Save_Click"/>
  </StackPanel>
 </Grid>
</Window>
