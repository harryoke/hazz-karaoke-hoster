<Window x:Class="HazzKaraokeHoster.App.MusicArchiveWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Music Playlists &amp; History" Width="1100" Height="720" MinWidth="850" MinHeight="560"
 Background="#0B0F14" Foreground="White" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#26313D"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#0E141B"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#111820"/><Setter Property="AlternatingRowBackground" Value="#17202A"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl x:Name="Tabs" Background="#111820" Foreground="White">
   <TabItem Header="PLAYLISTS">
    <Grid Margin="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="PlaylistGrid" AutoGenerateColumns="False" SelectionChanged="PlaylistGrid_SelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Playlist" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Tracks" Binding="{Binding TrackCount}" Width="70"/>
       <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="135"/>
      </DataGrid.Columns>
     </DataGrid>
     <DataGrid x:Name="PlaylistItemsGrid" Grid.Column="2" AutoGenerateColumns="False">
      <DataGrid.Columns>
       <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45"/>
       <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.1*"/>
       <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.7*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="MUSIC HISTORY">
    <DataGrid x:Name="HistoryGrid" Margin="8" AutoGenerateColumns="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="History List" Binding="{Binding SourceList}" Width="170"/>
      <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="45"/>
      <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.0*"/>
      <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.2*"/>
      <DataGridTextColumn Header="Played" Binding="{Binding PlayedAtLocal, StringFormat={}{0:g}}" Width="165"/>
      <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="80"/>
     </DataGrid.Columns>
    </DataGrid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="1" Margin="0,8,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Foreground="#9EABB9" VerticalAlignment="Center" Text="Hazz stores every played music track by date/time. Imported BPM Studio playlists/history are also preserved."/>
   <WrapPanel Grid.Column="1">
    <Button Content="REFRESH" Click="Refresh_Click"/>
    <Button Content="LOAD SELECTED / PLAYLIST → DECK 1" Click="LoadDeck1_Click"/>
    <Button Content="LOAD SELECTED / PLAYLIST → DECK 2" Click="LoadDeck2_Click"/>
    <Button Content="LOAD FULL HISTORY → DECK 1" Click="LoadFullHistoryDeck1_Click" ToolTip="Load every playable track currently shown in Music History into Deck 1, newest first."/>
    <Button Content="LOAD FULL HISTORY → DECK 2" Click="LoadFullHistoryDeck2_Click" ToolTip="Load every playable track currently shown in Music History into Deck 2, newest first."/>
    <Button Content="CLOSE" Click="Close_Click"/>
   </WrapPanel>
  </Grid>
 </Grid>
</Window>
