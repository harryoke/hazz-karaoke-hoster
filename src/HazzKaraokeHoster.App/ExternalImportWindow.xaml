<Window x:Class="HazzKaraokeHoster.App.ExternalImportWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Smart Import Preview" Width="980" Height="680" MinWidth="780" MinHeight="520"
 WindowStartupLocation="CenterOwner" Background="#0B0F14" Foreground="#F4F7FA" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2B3947"/><Setter Property="BorderBrush" Value="#607488"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#202A35"/><Setter Property="BorderBrush" Value="#607488"/><Setter Property="Padding" Value="8,5"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#18222D"/><Setter Property="Padding" Value="8,6"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#101820"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#111A23"/><Setter Property="AlternatingRowBackground" Value="#17222D"/><Setter Property="BorderBrush" Value="#40505F"/><Setter Property="RowHeight" Value="30"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#23313E"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="SMART IMPORT — DETECTED SOURCE" FontSize="22" FontWeight="Bold"/>
   <TextBlock x:Name="SourceText" Foreground="#AFC0D1" Margin="0,4,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#121C25" BorderBrush="#3E5061" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,12,0,10">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <TextBlock Text="Import records as" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
    <ComboBox x:Name="MediaModeCombo" Grid.Column="1" SelectedIndex="0">
     <ComboBoxItem Content="AUTO — detect Karaoke / Music" Tag="Auto"/>
     <ComboBoxItem Content="KARAOKE — all records" Tag="Karaoke"/>
     <ComboBoxItem Content="MUSIC — all records" Tag="Music"/>
    </ComboBox>
    <CheckBox x:Name="VerifyPathsCheck" Grid.Column="2" Content="Verify files exist (slower)" VerticalAlignment="Center" Foreground="White" Margin="18,0,0,0"/>
    <TextBlock Grid.Column="3" Text="Fast mode trusts the hoster's stored paths. Verification is slower on very large libraries." Foreground="#AFC0D1" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12,0,0,0"/>
   </Grid>
  </Border>
  <TextBlock x:Name="SummaryText" Grid.Row="2" Foreground="#DCE7F0" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <DataGrid x:Name="PreviewGrid" Grid.Row="3" AlternationCount="2">
   <DataGrid.Columns>
    <DataGridTextColumn Header="TYPE" Binding="{Binding SuggestedMediaKind}" Width="80"/>
    <DataGridTextColumn Header="ARTIST" Binding="{Binding Artist}" Width="1.05*"/>
    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.25*"/>
    <DataGridTextColumn Header="MANUFACTURER" Binding="{Binding Manufacturer}" Width="120"/>
    <DataGridTextColumn Header="DISC" Binding="{Binding DiscId}" Width="100"/>
    <DataGridTextColumn Header="FILE" Binding="{Binding FilePath}" Width="2*"/>
   </DataGrid.Columns>
  </DataGrid>
  <TextBlock x:Name="WarningText" Grid.Row="4" Foreground="#FFD071" TextWrapping="Wrap" Margin="0,10,0,6"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="CANCEL" IsCancel="True"/>
   <Button Content="IMPORT INTO HAZZ" IsDefault="True" Background="#3979A8" Click="Import_Click"/>
  </StackPanel>
 </Grid>
</Window>
