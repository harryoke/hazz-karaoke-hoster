<Window x:Class="HazzKaraokeHoster.App.AudienceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:HazzKaraokeHoster.App"
 Title="Hazz Audience Display" Background="Black" Foreground="White" Width="1280" Height="720" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Topmost="False">
 <Grid x:Name="Root" Background="Black" ClipToBounds="True">
  <!-- Singer-view artwork: only visible between karaoke performances. -->
  <Image x:Name="SingerBackgroundTransitionImage" Panel.ZIndex="0" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"/>
  <Image x:Name="SingerBackgroundImage" Panel.ZIndex="1" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed" IsHitTestVisible="False"/>

  <MediaElement x:Name="SingerBackgroundVideo" Panel.ZIndex="2" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" IsMuted="True" Volume="0" Visibility="Collapsed" IsHitTestVisible="False" MediaEnded="BackgroundVideo_Ended" MediaFailed="BackgroundVideo_Failed"/>

  <Image x:Name="SingerBackgroundGif" Panel.ZIndex="3" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>

  <!-- VJ layer: muted mirror of the video playing on a music deck. -->
  <local:AudienceVideoSurface x:Name="MusicVideoMedia" Panel.ZIndex="5"
                Visibility="Collapsed" IsHitTestVisible="False" MediaFailed="MusicVideo_Failed"/>

  <!-- Karaoke content layer. -->
  <local:AudienceVideoSurface x:Name="AudienceMedia" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False"/>
  <Image x:Name="AudienceCdgImage" Panel.ZIndex="11" Stretch="Uniform" Visibility="Collapsed" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>

  <Grid x:Name="AudienceOverlays" Panel.ZIndex="100" Background="{x:Null}" IsHitTestVisible="False">
  <!-- Music-video reveal cover. This lives inside the overlay host so it also works above LibVLC's native video surface. -->
  <Border x:Name="MusicVideoTransitionOverlay" Panel.ZIndex="1" Background="Black" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
   <Border.RenderTransform>
    <TransformGroup>
     <ScaleTransform x:Name="MusicVideoTransitionScale" ScaleX="1" ScaleY="1"/>
     <RotateTransform x:Name="MusicVideoTransitionRotate" Angle="0"/>
     <TranslateTransform x:Name="MusicVideoTransitionTranslate" X="0" Y="0"/>
    </TransformGroup>
   </Border.RenderTransform>
  </Border>

  <!-- Persistent logo: deliberately above CD+G and video. -->
  <Image x:Name="AudienceLogoImage" Panel.ZIndex="100" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"/>

  <!-- Optional venue branding and live queue summary for the between-song view. -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="30,66,30,0" Panel.ZIndex="109">
  <Border x:Name="VenueHeaderPanel" Panel.ZIndex="108" Background="#B5000000" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="20,8" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,6" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
   <TextBlock x:Name="VenueHeaderText" TextAlignment="Center" TextWrapping="Wrap" FontSize="28" FontWeight="Bold" Foreground="#FFFFD34D"/>
  </Border>
  <Border x:Name="QueueStatusPanel" Panel.ZIndex="109" Background="#B5000000" BorderBrush="#44FFFFFF" BorderThickness="1" Padding="14,7" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,6" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
   <TextBlock x:Name="QueueStatusText" FontSize="20" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
  </Border>

  </StackPanel>

  <!-- Kamikaze announcement replaces the normal singer information until the next karaoke track starts. -->
  <Border x:Name="KamikazePanel" Panel.ZIndex="115" Background="#C8000000" Padding="34,24" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" Visibility="Collapsed" MaxWidth="1120">
   <local:StrokeTextBlock x:Name="KamikazeTextBlock" Text="KAMIKAZE KARAOKE!" TextAlignment="Center" TextWrapping="Wrap" FontSize="84" FontWeight="Black" Foreground="#FFD34D"/>
  </Border>

  <!-- Automatic between-song call-up card for the next singer. -->
  <Border x:Name="SingerCallUpPanel" Panel.ZIndex="122" Background="#E0000000" BorderBrush="#FFFFD34D" BorderThickness="2" Padding="42,28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="60" Visibility="Collapsed" MaxWidth="1120" RenderTransformOrigin="0.5,0.5">
   <Viewbox Stretch="Uniform" StretchDirection="DownOnly"><StackPanel Width="1000">
    <TextBlock x:Name="SingerCallUpHeadingText" Text="NEXT SINGER" FontSize="28" FontWeight="Bold" Foreground="#FFFFD34D" HorizontalAlignment="Center"/>
    <TextBlock x:Name="SingerCallUpNameText" FontSize="72" FontWeight="Black" Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,2"/>
    <TextBlock x:Name="SingerCallUpSongText" FontSize="30" Foreground="#FFD8E2EF" TextAlignment="Center" TextWrapping="Wrap"/>
    <TextBlock x:Name="SingerCallUpMessageText" TextWrapping="Wrap" Text="Please make your way to the microphone" FontSize="22" Foreground="#FFB8C7D5" TextAlignment="Center" Margin="0,10,0,0"/>
   </StackPanel></Viewbox>
  </Border>

  <!-- Brief current-performer card when a karaoke track begins. -->
  <Border x:Name="NowSingingPanel" Panel.ZIndex="121" Background="#C8000000" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="22,14" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30" Visibility="Collapsed" MaxWidth="900" RenderTransformOrigin="0.5,0.5">
   <StackPanel>
    <TextBlock x:Name="NowSingingHeadingText" Text="NOW SINGING" FontSize="22" FontWeight="Bold" Foreground="#FFFFD34D"/>
    <TextBlock x:Name="NowSingingSingerText" FontSize="46" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
    <TextBlock x:Name="NowSingingSongText" FontSize="25" Foreground="#FFD8E2EF" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>

  <!-- Host-triggered temporary venue announcement. -->
  <Border x:Name="AnnouncementPanel" Panel.ZIndex="130" Background="#E0000000" BorderBrush="#FFFFD34D" BorderThickness="2" Padding="36,24" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="50" Visibility="Collapsed" MaxWidth="1120" RenderTransformOrigin="0.5,0.5">
   <TextBlock x:Name="AnnouncementText" TextAlignment="Center" TextWrapping="Wrap" FontSize="54" FontWeight="Bold" Foreground="White"/>
  </Border>

  <!-- Between songs the configured number of upcoming singers stay above the artwork/logo. -->
  <Border x:Name="NextSingerPanel" Panel.ZIndex="110" Background="#B0000000" Padding="22,14" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="30,30,30,74" Visibility="Collapsed" MaxWidth="1040">
   <Viewbox x:Name="SingerTextFit" Stretch="Uniform" StretchDirection="DownOnly">
   <StackPanel x:Name="SingerTextContent" Width="960">
    <local:StrokeTextBlock x:Name="NextSingerHeadingText" Text="COMING UP" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="#FFD34D" Margin="0,0,0,8"/>
    <StackPanel x:Name="NextSingersStack"/>
   </StackPanel>
   </Viewbox>
  </Border>
  <Border x:Name="ScrollerPanel" Panel.ZIndex="111" Background="#D0000000" VerticalAlignment="Bottom" Height="52" ClipToBounds="True">
   <Canvas x:Name="ScrollerCanvas"><local:StrokeTextBlock x:Name="ScrollerText" Text="" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"/></Canvas>
  </Border>
  <Border x:Name="SecondScrollerPanel" Panel.ZIndex="112" Background="#D0000000" VerticalAlignment="Top" Height="52" ClipToBounds="True" Visibility="Collapsed">
   <Canvas><local:StrokeTextBlock x:Name="SecondScrollerText" FontSize="30" FontWeight="SemiBold"/></Canvas>
  </Border>
  </Grid>
 </Grid>
</Window>
