<Application x:Class="HazzKaraokeHoster.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="CardBrush" Color="#202733"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#35D07F"/>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#303846"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#465164"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="6"/><Setter Property="Foreground" Value="White"/></Style>
    </Application.Resources>
</Application>
