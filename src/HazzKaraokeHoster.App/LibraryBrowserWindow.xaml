<Window x:Class="HazzKaraokeHoster.App.LibraryBrowserWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:HazzKaraokeHoster.App"
 Title="Hazz Library Browser and Virtual Folders" Width="1380" Height="780" MinWidth="980" MinHeight="560"
 Background="#0B0F14" Foreground="#F4F7FA" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285F82"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#23465F"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#26313D"/>
   <Setter Property="BorderBrush" Value="#4A5968"/><Setter Property="Padding" Value="10,6"/>
   <Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#0D131A"/>
   <Setter Property="BorderBrush" Value="#44515F"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="3"/>
   <Setter Property="CaretBrush" Value="White"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#202A35"/>
   <Setter Property="BorderBrush" Value="#657585"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="3"/><Setter Property="MinHeight" Value="31"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="ComboBox">
      <Grid>
       <Border x:Name="ComboChrome" Background="#18232D" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
       <ContentPresenter x:Name="SelectionPresenter" Margin="9,2,30,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                         Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                         ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="White" IsHitTestVisible="False"/>
       <ToggleButton x:Name="DropDownToggle" HorizontalAlignment="Right" Width="28" Focusable="False" ClickMode="Press"
                     IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <ToggleButton.Template>
         <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="ArrowChrome" Background="#2D3B47" BorderBrush="#657585" BorderThickness="1,0,0,0" CornerRadius="0,2,2,0">
           <Path Width="8" Height="5" Fill="White" Stretch="Fill" Data="M 0 0 L 8 0 L 4 5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#356B8F"/></Trigger>
           <Trigger Property="IsChecked" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="#285577"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </ToggleButton.Template>
       </ToggleButton>
       <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="360" Background="#111A22" BorderBrush="#8294A4" BorderThickness="1" Padding="2">
         <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
        </Border>
       </Popup>
      </Grid>
      <ControlTemplate.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboChrome" Property="BorderBrush" Value="#7EDCFF"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboChrome" Property="Background" Value="#25303A"/><Setter Property="Foreground" Value="#C5D0DA"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F7FAFC"/><Setter Property="Background" Value="#18222D"/><Setter Property="Padding" Value="8,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Style.Triggers>
    <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#356B8F"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285577"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="Margin" Value="8,0"/><Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#0E141B"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="RowBackground" Value="#111820"/><Setter Property="AlternatingRowBackground" Value="#17202A"/>
   <Setter Property="BorderBrush" Value="#34404D"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#293440"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="CanUserAddRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#222D38"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="7,5"/><Setter Property="BorderBrush" Value="#34404D"/>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type local:VirtualFolderNode}" ItemsSource="{Binding Children}">
   <TextBlock Text="{Binding DisplayText}" Foreground="#EEF6FF" FontSize="13" Margin="2"/>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
   <Setter Property="Padding" Value="2"/>
   <Setter Property="Foreground" Value="#EAF4FC"/>
   <Setter Property="Background" Value="#0D131A"/>
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#263D50"/><Setter Property="Foreground" Value="White"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#285F82"/><Setter Property="Foreground" Value="White"/></Trigger>
   </Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#111820" BorderBrush="#40505F" BorderThickness="1" CornerRadius="5" Padding="7">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="VIRTUAL FOLDERS" FontSize="16" FontWeight="Bold" Foreground="#D9E9F7" Margin="4,3,4,7"/>
    <Button Grid.Row="1" Content="ALL LIBRARY TRACKS" Click="AllLibrary_Click" Background="#315A78"/>
    <TreeView x:Name="FolderTree" Grid.Row="2" Margin="3,5" Background="#0D131A" Foreground="White"
              BorderBrush="#34404D" SelectedItemChanged="FolderTree_SelectedItemChanged"
              AllowDrop="True" DragOver="FolderTree_DragOver" Drop="FolderTree_Drop"
              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
    <UniformGrid Grid.Row="3" Columns="2">
     <Button Content="NEW FOLDER" Click="NewFolder_Click" Background="#286A9B"/>
     <Button Content="NEW SUBFOLDER" Click="NewSubfolder_Click"/>
     <Button Content="RENAME" Click="RenameFolder_Click"/>
     <Button Content="EMPTY" Click="EmptyFolder_Click" Background="#8A6519"/>
     <Button Content="DELETE" Click="DeleteFolder_Click" Background="#8D3434"/>
     <Button Content="ADD SELECTED TO FOLDER…" Click="AddSelectedToFolder_Click" Background="#356F45" FontSize="11"/>
    </UniformGrid>
    <TextBlock x:Name="FolderHint" Grid.Row="4" Margin="4,7,4,2" TextWrapping="Wrap" Foreground="#91A6B9"
               Text="Create folders such as 80s, Rock or Jingles. Drag tracks here; their files stay in their original location."/>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#40505F"/>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="KaraokeModeButton" Grid.Column="0" Content="KARAOKE" Click="KaraokeMode_Click" Background="#3979A8"/>
   <Button x:Name="MusicModeButton" Grid.Column="1" Content="MUSIC" Click="MusicMode_Click"/>
   <TextBox x:Name="FilterBox" Grid.Column="2" FontSize="16" TextChanged="FilterBox_TextChanged" ToolTip="Filter artist, title, manufacturer or disc ID. Leave blank to browse the entire indexed library."/>
   <ComboBox x:Name="SortCombo" Grid.Column="3" Width="145" SelectionChanged="SortChanged">
    <ComboBoxItem Content="Artist" IsSelected="True"/><ComboBoxItem Content="Title"/><ComboBoxItem Content="Manufacturer"/><ComboBoxItem Content="Date Added"/>
   </ComboBox>
    <CheckBox x:Name="DescendingCheck" Grid.Column="4" Content="Descending" FontWeight="SemiBold" Checked="SortChanged" Unchecked="SortChanged"/>
  </Grid>

  <TextBlock x:Name="BrowserHint" Grid.Row="1" Margin="5,4,5,7" Foreground="#8FA0B2"
             Text="Karaoke: drag a track onto a singer in the main window, or select a singer there and use ADD TO SELECTED SINGER."/>

  <DataGrid x:Name="LibraryGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" FontSize="13" SelectionMode="Extended"
            EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            PreviewMouseLeftButtonDown="LibraryGrid_PreviewMouseLeftButtonDown" PreviewMouseMove="LibraryGrid_PreviewMouseMove"
            PreviewMouseWheel="LibraryGrid_PreviewMouseWheel" MouseDoubleClick="LibraryGrid_MouseDoubleClick">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="1.25*"/>
    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="1.55*"/>
    <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}" Width="0.85*"/>
    <DataGridTextColumn Header="Disc / Track" Binding="{Binding DiscId}" Width="0.85*"/>
    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="82"/>
    <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="1.5*"/>
   </DataGrid.Columns>
  </DataGrid>

  <Grid Grid.Row="3" Margin="0,7,0,3">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Orientation="Horizontal">
    <Button Content="|◀ FIRST" Click="FirstPage_Click"/><Button Content="◀ PREV" Click="PreviousPage_Click"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
    <TextBlock Text="Page" VerticalAlignment="Center" Margin="3"/>
    <TextBox x:Name="PageBox" Width="75" Text="1" TextAlignment="Center"/>
    <Button Content="GO" Click="GoPage_Click"/>
    <TextBlock x:Name="PageStatusText" Text="of 1 • 0 tracks" VerticalAlignment="Center" Margin="8,0" Foreground="#AFC0D1"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="NEXT ▶" Click="NextPage_Click"/><Button Content="LAST ▶|" Click="LastPage_Click"/>
   </StackPanel>
  </Grid>

  <Grid Grid.Row="4" Margin="0,4,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#8FA0B2" VerticalAlignment="Center" Text="Loading library..."/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="REMOVE FROM FOLDER" Click="RemoveFromFolder_Click" Background="#8A4D35"/>
    <Button x:Name="AddSingerButton" Content="ADD TO SELECTED SINGER" Click="AddSinger_Click"/>
    <Button x:Name="AddDeck1Button" Content="ADD TO DECK 1" Click="AddDeck1_Click" Visibility="Collapsed"/>
    <Button x:Name="AddDeck2Button" Content="ADD TO DECK 2" Click="AddDeck2_Click" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  </Grid>
 </Grid>
</Window>
